{
  "name": "@morehao/dsh-skills-console",
  "version": "0.1.0",
  "description": "DSH 技能控制台：技能真身只由 skills CLI 写，本插件只管可见性、接入与生命周期——装 / 更新 / 删除 / 启停、四态软链、回收站、订阅。",
  "license": "MIT",
  "author": "morehao <morehao@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morehao/dsh-skills-console.git"
  },
  "homepage": "https://github.com/morehao/dsh-skills-console#readme",
  "bugs": {
    "url": "https://github.com/morehao/dsh-skills-console/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node scripts/check-syntax.mjs && node scripts/check-naming.mjs && node scripts/check-pack.mjs && node scripts/smoke-release-notes.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:naming": "node scripts/check-naming.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:release-notes": "node scripts/smoke-release-notes.mjs",
    "sync:agents": "node scripts/sync-agent-table.mjs"
  },
  "engines": {
    "node": "^22.20.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills"
  ]
}
