{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "useUnknownInCatchVariables": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "react"
    ],
    "allowJs": false,
    "noImplicitAny": false
  },
  "include": [
    "client",
    "lib/contract"
  ]
}
